# ==============================================================================
# Configuración del Resumen Semanal de Entrenamientos (Lyfta -> Gmail)
# Copia este archivo como .env y rellena tus credenciales para pruebas locales.
# ==============================================================================

# Token Bearer de la API de Lyfta (obtenido en my.lyfta.app)
LYFTA_API_KEY=tu_token_bearer_de_lyfta_aqui

# Dirección de Gmail emisora y receptora
GMAIL_ADDRESS=tu_correo@gmail.com

# Contraseña de aplicación de 16 caracteres generada en tu cuenta de Google
# (NO utilices tu contraseña personal habitual)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
